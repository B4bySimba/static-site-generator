# Copy to .env and adjust. Site configuration lives in the project's site.json;
# these are the build/serve knobs.

# Dev server
SSG_PORT=4321
SSG_HOST=127.0.0.1

# Include draft and future-dated pages (dev defaults to true, production to false)
SSG_INCLUDE_DRAFTS=false
SSG_INCLUDE_SCHEDULED=false

# Output processing
SSG_MINIFY=true
SSG_HASH_ASSETS=true

# Pin the build clock so output is byte-identical across runs
SSG_DETERMINISTIC=false
